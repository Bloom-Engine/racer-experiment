{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://race-assets.local/manifest.schema.json",
  "title": "race-assets manifest",
  "description": "Describes every file, node name and metric of the procedurally generated racing game asset set.",
  "type": "object",
  "required": ["name", "version", "rebuild_command", "conventions", "budgets", "car", "track", "scenery", "environment",
               "textures", "audio", "ui", "licenses", "files"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {"type": "string"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string"},
    "rebuild_command": {"type": "string"},
    "conventions": {
      "type": "object",
      "required": ["gltf_version", "units", "up_axis", "forward_axis", "handedness", "pbr", "orm_packing"],
      "properties": {
        "gltf_version": {"const": "2.0"},
        "units": {"const": "metre"},
        "up_axis": {"const": "+Y"},
        "forward_axis": {"const": "-Z"},
        "handedness": {"const": "right"},
        "pbr": {"const": "metallic-roughness"}
      }
    },
    "budgets": {
      "type": "object",
      "required": ["car_triangles_max", "car_triangles", "car_collider_triangles_max", "car_collider_triangles",
                   "track_scene_triangles_max", "track_scene_triangles", "static_draw_calls_max", "static_draw_calls"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "car": {
      "type": "object",
      "required": ["file", "root_node", "forward", "up", "origin", "nodes", "wheel_rotation", "metrics", "variants", "collider", "triangles"],
      "properties": {
        "file": {"$ref": "#/$defs/glbPath"},
        "root_node": {"type": "string"},
        "forward": {"$ref": "#/$defs/vec3"},
        "up": {"$ref": "#/$defs/vec3"},
        "nodes": {
          "type": "object",
          "required": ["body", "wheels", "brake_lights", "exhausts", "collider"],
          "properties": {
            "body": {"const": "body"},
            "brake_lights": {"const": "brake_lights"},
            "collider": {"const": "collider_body"},
            "wheels": {
              "type": "object",
              "required": ["wheel_FL", "wheel_FR", "wheel_RL", "wheel_RR"],
              "additionalProperties": {
                "type": "object", "required": ["node", "position"],
                "properties": {"node": {"type": "string"}, "position": {"$ref": "#/$defs/vec3"}}
              }
            },
            "exhausts": {
              "type": "object", "required": ["exhaust_L", "exhaust_R"],
              "additionalProperties": {
                "type": "object", "required": ["node", "position"],
                "properties": {"node": {"type": "string"}, "position": {"$ref": "#/$defs/vec3"}}
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": ["wheel_radius_m", "wheel_width_m", "track_width_m", "wheelbase_m", "suggested_mass_kg", "centre_of_mass_offset_m"],
          "properties": {
            "wheel_radius_m": {"$ref": "#/$defs/posNumber"},
            "wheel_width_m": {"$ref": "#/$defs/posNumber"},
            "track_width_m": {"$ref": "#/$defs/posNumber"},
            "wheelbase_m": {"$ref": "#/$defs/posNumber"},
            "suggested_mass_kg": {"$ref": "#/$defs/posNumber"},
            "centre_of_mass_offset_m": {"$ref": "#/$defs/vec3"}
          }
        },
        "variants": {
          "type": "array", "minItems": 4,
          "items": {
            "type": "object",
            "required": ["name", "khr_materials_variants_index", "material", "albedo_texture", "default"],
            "properties": {
              "name": {"enum": ["red", "blue", "yellow", "black"]},
              "khr_materials_variants_index": {"type": "integer", "minimum": 0},
              "material": {"type": "string"},
              "albedo_texture": {"$ref": "#/$defs/pngPath"},
              "default": {"type": "boolean"}
            }
          }
        },
        "collider": {
          "type": "object", "required": ["node", "triangles", "hidden"],
          "properties": {"triangles": {"type": "integer", "maximum": 200}, "hidden": {"const": true}}
        },
        "triangles": {
          "type": "object", "required": ["visual_total", "collider_body"],
          "properties": {"visual_total": {"type": "integer", "maximum": 25000}}
        }
      }
    },
    "track": {
      "type": "object",
      "required": ["file", "root_node", "length_m", "road_width_m", "features", "nodes", "spawns", "checkpoints", "racing_line",
                   "minimap", "triangles", "draw_calls_static_visual"],
      "properties": {
        "file": {"$ref": "#/$defs/glbPath"},
        "length_m": {"type": "number", "minimum": 1800, "maximum": 2500},
        "road_width_m": {"type": "number", "minimum": 12, "maximum": 16},
        "elevation_range_m": {"type": "array", "items": {"type": "number", "minimum": -12, "maximum": 12}, "minItems": 2, "maxItems": 2},
        "features": {
          "type": "array",
          "items": {"type": "object", "required": ["type", "s_start", "s_end"],
                    "properties": {"type": {"enum": ["start_finish_straight", "hairpin", "fast_sweeper", "s_section", "hill"]}}},
          "allOf": [
            {"contains": {"properties": {"type": {"const": "start_finish_straight"}}}},
            {"contains": {"properties": {"type": {"const": "hairpin"}}}},
            {"contains": {"properties": {"type": {"const": "fast_sweeper"}}}},
            {"contains": {"properties": {"type": {"const": "s_section"}}}},
            {"contains": {"properties": {"type": {"const": "hill"}}}}
          ]
        },
        "nodes": {
          "type": "object", "required": ["visual", "collision"],
          "properties": {
            "visual": {"type": "array", "items": {"type": "string"},
                       "allOf": [{"contains": {"const": "road"}}, {"contains": {"const": "kerbs"}},
                                 {"contains": {"const": "barriers"}}, {"contains": {"const": "terrain"}},
                                 {"contains": {"pattern": "^scenery_"}}]},
            "collision": {"type": "object", "required": ["col_road", "col_barriers", "col_terrain"]}
          }
        },
        "spawns": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"type": "object", "required": ["name", "position", "rotation", "forward"],
                    "properties": {"name": {"pattern": "^spawn_[1-4]$"}, "position": {"$ref": "#/$defs/vec3"},
                                   "rotation": {"$ref": "#/$defs/quat"}, "forward": {"$ref": "#/$defs/vec3"}}}
        },
        "checkpoints": {
          "type": "array", "minItems": 12,
          "items": {"type": "object", "required": ["name", "index", "position", "rotation", "box_size", "box_center_local"],
                    "properties": {"name": {"pattern": "^cp_\\d{2}$"}, "index": {"type": "integer", "minimum": 0},
                                   "position": {"$ref": "#/$defs/vec3"}, "rotation": {"$ref": "#/$defs/quat"},
                                   "box_size": {"$ref": "#/$defs/vec3"}, "box_center_local": {"$ref": "#/$defs/vec3"}}}
        },
        "racing_line": {
          "type": "object", "required": ["file", "points", "closed"],
          "properties": {"file": {"type": "string", "pattern": "\\.json$"}, "points": {"type": "integer", "minimum": 200},
                         "closed": {"const": true}}
        },
        "minimap": {
          "type": "object", "required": ["file", "image_size_px", "world_to_map_matrix", "pixels_per_metre", "offset_px"],
          "properties": {
            "file": {"$ref": "#/$defs/pngPath"},
            "image_size_px": {"type": "array", "items": {"const": 1024}, "minItems": 2, "maxItems": 2},
            "world_to_map_matrix": {"type": "array", "minItems": 2, "maxItems": 2,
                                    "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}}
          }
        },
        "triangles": {"type": "object", "required": ["total"], "properties": {"total": {"type": "integer", "maximum": 300000}}},
        "draw_calls_static_visual": {"type": "integer", "maximum": 40}
      }
    },
    "scenery": {
      "type": "object", "required": ["file", "prototypes", "instances"],
      "properties": {
        "file": {"$ref": "#/$defs/glbPath"},
        "prototypes": {"type": "object", "additionalProperties": {"type": "object", "required": ["node", "triangles"]}},
        "instances": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "object", "required": ["translation", "rotation", "scale"],
                      "properties": {"translation": {"$ref": "#/$defs/vec3"}, "rotation": {"$ref": "#/$defs/quat"},
                                     "scale": {"$ref": "#/$defs/vec3"}}}
          }
        }
      }
    },
    "environment": {
      "type": "object", "required": ["sky", "sun"],
      "properties": {
        "sky": {"type": "object", "required": ["background", "environment_lighting", "mapping"],
                "properties": {"background": {"type": "object", "required": ["file", "width", "height"],
                                              "properties": {"width": {"const": 2048}, "height": {"const": 1024}}}}},
        "sun": {"type": "object", "required": ["direction", "color_linear"],
                "properties": {"direction": {"$ref": "#/$defs/vec3"}, "color_linear": {"$ref": "#/$defs/vec3"}}}
      }
    },
    "textures": {"type": "object", "required": ["ground_materials", "all"],
                 "properties": {"ground_materials": {"type": "object", "required": ["asphalt", "kerb", "grass", "gravel"]}}},
    "audio": {
      "type": "object", "required": ["sounds"],
      "properties": {
        "sounds": {
          "type": "object",
          "required": ["engine_idle", "engine_mid", "engine_high", "collision_light", "collision_heavy", "tyre_screech_loop",
                       "nitro_whoosh", "countdown", "beep_short", "beep_long", "finish_fanfare"],
          "additionalProperties": {"type": "object", "required": ["wav", "ogg", "loop", "duration_s"],
                                   "properties": {"wav": {"pattern": "\\.wav$"}, "ogg": {"pattern": "\\.ogg$"}, "loop": {"type": "boolean"}}}
        }
      }
    },
    "ui": {
      "type": "object", "required": ["icons", "font"],
      "properties": {
        "icons": {"type": "object",
                  "required": ["nitro", "pause", "camera", "reset", "steer_left", "steer_right", "brake"],
                  "additionalProperties": {"type": "object", "required": ["svg"]}},
        "font": {"type": "object", "required": ["file", "license", "license_file"]}
      }
    },
    "licenses": {"type": "object", "required": ["default"]},
    "files": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["path", "type", "bytes", "sha256"],
                "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0},
                               "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    }
  },
  "$defs": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "quat": {"type": "array", "items": {"type": "number", "minimum": -1, "maximum": 1}, "minItems": 4, "maxItems": 4},
    "posNumber": {"type": "number", "exclusiveMinimum": 0},
    "glbPath": {"type": "string", "pattern": "\\.glb$"},
    "pngPath": {"type": "string", "pattern": "\\.png$"}
  }
}
